<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
  <http:listener-config name="demo-http"><http:listener-connection host="127.0.0.1" port="8081"/></http:listener-config>
  <flow name="timetable-http">
    <http:listener config-ref="demo-http" path="/timetable" allowedMethods="GET"/>
    <set-variable variableName="day" value="#[attributes.queryParams.day default 'monday']"/>
    <flow-ref name="timetable-response"/>
  </flow>
  <flow name="timetable-response">
    <flow-ref name="load-synthetic-sessions"/>
    <set-payload value="#[output application/json --- payload filter ((session) -&gt; session.day == (vars.day default 'monday'))]"/>
  </flow>
  <sub-flow name="load-synthetic-sessions"><set-payload value="#[readUrl('classpath://timetable.json', 'application/json')]"/></sub-flow>
</mule>
